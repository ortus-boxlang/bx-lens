/**
 * bx-lens Data Collector Interceptor
 *
 * Listens to BoxLang runtime events and populates the per-request lens data struct
 * stored as a context attachment under the key "__bxLensData__".
 */
class {

	property name="moduleRecord";
	property name="log";

	/**
	 * Fired before the request template is executed.
	 * Initialises the lens data attachment for this request.
	 */
	function onRequestStart( data ) {
		var ctx = data.context;
		if ( isNull( ctx ) ) return;

		var svc   = moduleRecord.settings.lensService;
		var reqId = svc.startRequest();

		var lensData = {
			requestId       : reqId,
			enabled         : moduleRecord.settings.enabled,
			startedAt       : getTickCount(),
			endedAt         : 0,
			method          : "",
			url             : "",
			statusCode      : 200,
			applicationName : "",
			queries         : [],
			exceptions      : [],
			templates       : [],
			httpCalls       : [],
			soapCalls       : [],
			messages        : [],
			timings         : [],
			_pendingTimings  : {},
			variables       : {
				form        : {},
				url         : {},
				cgi         : {},
				request     : {},
				session     : {},
				application : {}
			},
			globalStats : {}
		};

		// Capture HTTP method/URL safely (not available in CLI context)
		try {
			var exchange  = ctx.getHTTPExchange();
			lensData.method = exchange.getRequestMethod() ?: "";
			lensData.url    = exchange.getRequestURL()    ?: "";
		} catch ( any e ) {}

		ctx.putAttachment( "__bxLensData__", lensData );
	}

	/**
	 * Fired after the request completes.
	 * Captures scope snapshots and finalises timing.
	 */
	function onRequestEnd( data ) {
		var ctx      = data.context;
		if ( isNull( ctx ) ) return;
		var lensData = ctx.getAttachment( "__bxLensData__" );
		if ( isNull( lensData ) ) return;

		var svc      = moduleRecord.settings.lensService;
		lensData.endedAt = getTickCount();
		var duration     = lensData.endedAt - lensData.startedAt;
		svc.endRequest( javaCast( "long", duration ) );

		// Application name
		try { lensData.applicationName = application.applicationName ?: "" } catch ( any e ) {}

		// Scope snapshots — only for enabled scopes
		var scopes = moduleRecord.settings.scopes;
		if ( scopes.form        ) { try { lensData.variables.form        = duplicate( form        ) } catch ( any e ) {} }
		if ( scopes.url         ) { try { lensData.variables.url         = duplicate( url         ) } catch ( any e ) {} }
		if ( scopes.cgi         ) { try { lensData.variables.cgi         = duplicate( cgi         ) } catch ( any e ) {} }
		if ( scopes.request     ) { try { lensData.variables.request     = duplicate( request     ) } catch ( any e ) {} }
		if ( scopes.session     ) { try { lensData.variables.session     = duplicate( session     ) } catch ( any e ) {} }
		if ( scopes.application ) { try { lensData.variables.application = duplicate( application ) } catch ( any e ) {} }

		// Global stats snapshot
		lensData.globalStats = svc.getStats().snapshot();
	}

	/**
	 * Fired after a SQL query executes.
	 */
	function postQueryExecute( data ) {
		var ctx      = _getContext( data );
		var lensData = _getLensData( ctx );
		if ( isNull( lensData ) || !lensData.enabled ) return;
		if ( lensData.queries.len() >= moduleRecord.settings.maxQueries ) return;

		moduleRecord.settings.lensService.getStats().totalQueries.incrementAndGet();
		lensData.queries.append( {
			sql           : data.sql           ?: "",
			executionTime : data.executionTime ?: 0,
			recordCount   : data.recordCount   ?: 0,
			params        : data.params        ?: {},
			offset        : getTickCount() - lensData.startedAt
		} );
	}

	/**
	 * Fired before a template/page is invoked.
	 */
	function preTemplateInvoke( data ) {
		var ctx      = _getContext( data );
		var lensData = _getLensData( ctx );
		if ( isNull( lensData ) || !lensData.enabled ) return;

		// Nesting depth = number of currently pending template entries
		var depth = 0;
		for ( var t in lensData.templates ) {
			if ( t._pending ) depth++;
		}

		lensData.templates.append( {
			templatePath  : data.templatePath ?: "",
			executionTime : 0,
			offset        : getTickCount() - lensData.startedAt,
			depth         : depth,
			_pending      : true,
			_startTick    : getTickCount()
		} );
	}

	/**
	 * Fired after a template/page finishes executing.
	 */
	function postTemplateInvoke( data ) {
		var ctx      = _getContext( data );
		var lensData = _getLensData( ctx );
		if ( isNull( lensData ) || !lensData.enabled ) return;
		if ( lensData.templates.len() >= moduleRecord.settings.maxTemplates ) return;

		var path = data.templatePath ?: "";
		// Walk backwards to find the most-recent pending entry for this path
		for ( var i = lensData.templates.len(); i >= 1; i-- ) {
			var t = lensData.templates[ i ];
			if ( t._pending && t.templatePath == path ) {
				t.executionTime = data.executionTime ?: ( getTickCount() - t._startTick );
				t._pending      = false;
				structDelete( t, "_startTick" );
				break;
			}
		}
	}

	/**
	 * Fired when an exception occurs.
	 */
	function onException( data ) {
		var ctx      = _getContext( data );
		var lensData = _getLensData( ctx );
		if ( isNull( lensData ) || !lensData.enabled ) return;
		if ( lensData.exceptions.len() >= moduleRecord.settings.maxExceptions ) return;

		moduleRecord.settings.lensService.getStats().totalExceptions.incrementAndGet();
		var ex = data.exception;
		if ( isNull( ex ) ) return;
		lensData.exceptions.append( {
			type       : ex.type       ?: "unknown",
			message    : ex.message    ?: "",
			detail     : ex.detail     ?: "",
			stackTrace : ex.stackTrace ?: "",
			offset     : getTickCount() - lensData.startedAt
		} );
	}

	/**
	 * Fired before an outgoing HTTP request is made.
	 */
	function onHTTPRequest( data ) {
		var ctx      = _getContext( data );
		var lensData = _getLensData( ctx );
		if ( isNull( lensData ) || !lensData.enabled ) return;

		lensData.httpCalls.append( {
			method        : data.method     ?: "GET",
			url           : data.url        ?: "",
			statusCode    : 0,
			executionTime : 0,
			requestSize   : data.bodyLength ?: 0,
			responseSize  : 0,
			offset        : getTickCount() - lensData.startedAt,
			_pending      : true,
			_startTick    : getTickCount()
		} );
	}

	/**
	 * Fired after an outgoing HTTP response is received.
	 */
	function onHTTPResponse( data ) {
		var ctx      = _getContext( data );
		var lensData = _getLensData( ctx );
		if ( isNull( lensData ) || !lensData.enabled ) return;

		moduleRecord.settings.lensService.getStats().totalHttpCalls.incrementAndGet();
		var url = data.url ?: "";
		// Close the most-recent pending HTTP call for this URL
		for ( var i = lensData.httpCalls.len(); i >= 1; i-- ) {
			var h = lensData.httpCalls[ i ];
			if ( h._pending && h.url == url ) {
				h.statusCode    = data.statusCode    ?: 0;
				h.responseSize  = data.responseSize  ?: 0;
				h.executionTime = data.executionTime ?: ( getTickCount() - h._startTick );
				h._pending      = false;
				structDelete( h, "_startTick" );
				break;
			}
		}
	}

	/**
	 * Fired before an outgoing SOAP request.
	 */
	function onSOAPRequest( data ) {
		var ctx      = _getContext( data );
		var lensData = _getLensData( ctx );
		if ( isNull( lensData ) || !lensData.enabled ) return;

		lensData.soapCalls.append( {
			endpoint      : data.endpoint ?: "",
			action        : data.action   ?: "",
			statusCode    : 0,
			executionTime : 0,
			responseSize  : 0,
			offset        : getTickCount() - lensData.startedAt,
			_pending      : true,
			_startTick    : getTickCount()
		} );
	}

	/**
	 * Fired after an outgoing SOAP response is received.
	 */
	function onSOAPResponse( data ) {
		var ctx      = _getContext( data );
		var lensData = _getLensData( ctx );
		if ( isNull( lensData ) || !lensData.enabled ) return;

		moduleRecord.settings.lensService.getStats().totalSoapCalls.incrementAndGet();
		for ( var i = lensData.soapCalls.len(); i >= 1; i-- ) {
			var s = lensData.soapCalls[ i ];
			if ( s._pending ) {
				s.statusCode    = data.statusCode    ?: 0;
				s.responseSize  = data.responseSize  ?: 0;
				s.executionTime = data.executionTime ?: ( getTickCount() - s._startTick );
				s._pending      = false;
				structDelete( s, "_startTick" );
				break;
			}
		}
	}

	/**
	 * Track active sessions in GlobalStats.
	 */
	function onSessionStart( data ) {
		moduleRecord.settings.lensService.getStats().activeSessions.incrementAndGet();
	}

	function onSessionEnd( data ) {
		moduleRecord.settings.lensService.getStats().activeSessions.decrementAndGet();
	}

	// -------------------------------------------------------------------------
	// Private helpers
	// -------------------------------------------------------------------------

	private function _getContext( data ) {
		return data.context ?: getBoxContext();
	}

	private function _getLensData( ctx ) {
		if ( isNull( ctx ) ) return;
		return ctx.getAttachment( "__bxLensData__" );
	}

}
