/**
 * LensStop( labelOrHash ) — Stop a custom timer started with LensStart().
 *
 * Pass either the hash returned by LensStart() (exact match) or the label string
 * (closes the most-recent pending timer with that label).
 *
 * The completed timing appears in the Timings tab and the Timeline.
 *
 * @labelOrHash  Hash from LensStart() or the original label string.
 */
@BoxBIF( "LensStop" )
class {

	property name="moduleRecord";

	function invoke( required string labelOrHash ) {
		var d = ( getBoxContext().getRequestContext() ?: getBoxContext() ).getAttachment( "__bxLensData__" );
		if ( isNull( d ) || !d.enabled ) return;
		if ( !structKeyExists( d, "_pendingTimings" ) ) return;
		if ( d.timings.len() >= moduleRecord.settings.maxTimings ) return;

		var pending = d._pendingTimings;
		var found   = "";

		// Try exact hash first
		if ( structKeyExists( pending, labelOrHash ) ) {
			found = labelOrHash;
		} else {
			// Fall back to most-recent by label
			for ( var k in pending ) {
				if ( pending[ k ].label == labelOrHash ) {
					found = k;
				}
			}
		}

		if ( !len( found ) ) return;

		var t = pending[ found ];
		d.timings.append( {
			label         : t.label,
			executionTime : getTickCount() - t._startTick,
			offset        : t.offset,
			hash          : found
		} );
		structDelete( pending, found );
	}

}
