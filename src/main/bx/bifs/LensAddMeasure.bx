/**
 * LensAddMeasure( label, executionTime [, offset] ) — Add a pre-computed timing to the debug panel.
 *
 * Use this when you have already measured a duration externally and want to record it.
 * The timing appears in the Timings tab and the Timeline.
 *
 * @label          Display name for the timing entry.
 * @executionTime  Duration in milliseconds.
 * @offset         Optional ms from request start. Defaults to "now".
 */
@BoxBIF( "LensAddMeasure" )
class {

	property name="moduleRecord";

	function invoke( required string label, required numeric executionTime, numeric offset = 0 ) {
		var d = ( getBoxContext().getRequestContext() ?: getBoxContext() ).getAttachment( "__bxLensData__" );
		if ( isNull( d ) || !d.enabled ) return;
		if ( d.timings.len() >= moduleRecord.settings.maxTimings ) return;

		d.timings.append( {
			label         : label,
			executionTime : executionTime,
			offset        : offset > 0 ? offset : getTickCount() - d.startedAt,
			hash          : createUUID()
		} );
	}

}
