/**
 * LensEnable() — Enable the bx-lens debug bar for the current request.
 *
 * Call this in Application.bx onRequestStart or at the top of any template
 * to override the module's default enabled setting.
 *
 * @return true
 */
@BoxBIF( "LensEnable" )
class {

	property name="moduleRecord";

	function invoke() {
		var d = ( getBoxContext().getRequestContext() ?: getBoxContext() ).getAttachment( "__bxLensData__" );
		if ( !isNull( d ) ) {
			d.enabled = true;
		}
		return true;
	}

}
