/**
 * LensMeasure( labelOrClosure [, closure] ) — Time a closure and record it as a custom timing.
 *
 * Two calling conventions:
 *   LensMeasure( "My Operation", () => { ... } )
 *   LensMeasure( () => { ... } )   // label = "anonymous"
 *
 * Returns whatever value the closure returns.
 *
 * @labelOrClosure  Label string, or the closure when called with one argument.
 * @closure         The closure to time (omit when first arg is the closure).
 * @return          The return value of the executed closure.
 */
@BoxBIF( "LensMeasure" )
class {

	property name="moduleRecord";

	function invoke( required any labelOrClosure, any closure = javaCast( "null", "" ) ) {
		var label = "anonymous";
		var fn    = closure;

		if ( isClosure( labelOrClosure ) || isCustomFunction( labelOrClosure ) ) {
			fn = labelOrClosure;
		} else {
			label = labelOrClosure;
		}

		var start  = getTickCount();
		var result = fn();
		var elapsed = getTickCount() - start;

		var d = ( getBoxContext().getRequestContext() ?: getBoxContext() ).getAttachment( "__bxLensData__" );
		if ( !isNull( d ) && d.enabled ) {
			LensAddMeasure( label = label, executionTime = elapsed );
		}

		return result;
	}

}
