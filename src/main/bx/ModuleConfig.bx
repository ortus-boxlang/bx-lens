/**
 * BX Lens: a request level debug bar for BoxLang web applications.
 *
 * Everything that collects data is Java (see src/main/java). This file only declares settings and wires the module lifecycle.
 * Settings go in boxlang.json under modules.bxLens.settings. Lens is OFF by default.
 */
import java:ortus.boxlang.modules.bxlens.LensService;

class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	this.version      = "@build.version@+@build.number@";
	this.mapping      = "bxlens";
	this.author       = "Ortus Solutions";
	this.description  = "A request level debug bar for BoxLang web applications: timeline, queries, templates, cache, modules and more.";
	this.webURL       = "https://github.com/ortus-boxlang/bx-lens";
	this.enabled      = true;
	this.dependencies = [];

	/**
	 * Settings and interception points. All settings are documented in docs/configuration.md.
	 */
	function configure() {
		settings = {
			// Master switch. Lens is off by default. Never turn it on for a public site.
			enabled : false,

			// Who may be tracked and shown the bar
			access : {
				// Exact IPs, CIDR ranges, or "*" for everyone (dangerous)
				allowedIPs           : [ "127.0.0.1", "::1" ],
				// Also allow private network ranges (10/8, 172.16/12, 192.168/16, fc00::/7, link-local)
				allowPrivateNetworks : true,
				// Restrict to these Host header names. Empty means any host
				allowedHosts         : [],
				// Require a request header: "Name" or "Name=value". Empty means none
				requireHeader        : ""
			},

			// Inject the bar before </body> on HTML responses. Set false and call lensRender() to place it yourself
			inject       : true,
			contentTypes : [ "text/html" ],
			excludePaths : [ "/~bxlens/*", "/favicon.ico" ],

			// In-memory history ring buffer. The oldest request is recycled when full. Nothing is written to disk
			history : {
				trackNonHtml : true,
				header       : "X-BxLens-Id",
				maxRequests  : 50
			},

			ui : {
				// auto follows the OS, or dark | light
				theme               : "auto",
				// Start with the panel open instead of the collapsed health strip
				startOpen           : false,
				// Open the panel to Issues when an exception was caught
				autoOpenOnException : true,
				defaultTab          : "timeline",
				height              : 360,
				allowDetach         : true,
				// Toggle the panel. Modifiers: Ctrl, Alt, Shift, Meta
				hotkey              : "Ctrl+`"
			},

			// What counts as slow or suspicious
			thresholds : {
				slowRequestMs  : 500,
				slowQueryMs    : 25,
				slowTemplateMs : 100,
				nPlusOneMin    : 3
			},

			// Click-to-editor links. {path} and {line} are replaced. Map container paths with remoteBase/localBase
			editor : {
				linkPattern : "vscode://file/{path}:{line}",
				remoteBase  : "",
				localBase   : ""
			},

			// Values under these keys are masked on the server before they reach the page
			redact : {
				keys : [ "password", "pwd", "passwd", "token", "secret", "apikey", "api_key", "authorization", "cookie", "credential" ],
				mask : "[redacted]"
			},

			// Caps for any value sent to the page
			limits : {
				maxString : 2000,
				maxDepth  : 4,
				maxItems  : 100
			},

			collectors : {
				templates    : { enabled : true, max : 300 },
				// Hot path, off by default
				functions    : { enabled : false, max : 1000, minMs : 0 },
				queries      : { enabled : true, max : 200, includeParams : true, captureCaller : true },
				http         : { enabled : true, max : 100 },
				exceptions   : { enabled : true, max : 50 },
				messages     : { enabled : true, max : 200 },
				timers       : { enabled : true, max : 200 },
				transactions : { enabled : true, max : 50 },
				logs         : { enabled : false, max : 200 },
				scopes       : { enabled : true, url : true, form : true, cookie : false, session : false, request : false, application : false, variables : false },
				jvm          : { enabled : true },
				cache        : { enabled : true },
				modules      : { enabled : true }
			}
		};

		// Extension points for applications and other modules. See docs/guides/extending.md
		customInterceptionPoints = [
			"onLensRegister",
			"onLensRequestStart",
			"onLensCollect",
			"onLensRequestFinish"
		];

		interceptors = [];
	}

	/**
	 * Activate: parse the settings, register the collectors.
	 */
	function onLoad() {
		LensService.getInstance().activate(
			boxRuntime,
			settings,
			moduleRecord.physicalPath.toString(),
			moduleRecord.version
		);
	}

	/**
	 * Other modules may have loaded after us, so ask for panel declarations again once all are active.
	 */
	function afterModuleActivations( data ) {
		LensService.getInstance().announceRegister();
	}

	function onUnload() {
		LensService.getInstance().shutdown();
	}

}
