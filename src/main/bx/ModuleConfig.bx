/**
 * BoxLang Lens Module
 * ---
 * A module can have the following folders that will be automatically registered:
 * + bifs - Custom BIFs that will be registered into the runtime
 * + interceptors - Custom interceptors that will be registered into the runtime via the configure() method
 * + libs - Custom java libraries that your module leverages
 * + tags - Custom tags that will be registered into the runtime
 *
 * Every module will have its own classloader that will be used to load the module libs and dependencies.
 */
class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	/**
	 * --------------------------------------------------------------------------
	 * Module Properties
	 * --------------------------------------------------------------------------
	 * Here is where you define the properties of your module that the module service
	 * will use to register and activate your module
	 */

	/**
	 * Your module version. Try to use semantic versioning
	 * @mandatory
	 */
	this.version = "@build.version@+@build.number@"

	/**
	 * The BoxLang mapping for your module.  All BoxLang modules are registered with an internal
	 * mapping prefix of : bxModules.{this.mapping}, /bxmodules/{this.mapping}. Ex: bxModules.test, /bxmodules/test
	 */
	this.mapping = "bxlens"

	/**
	 * The public mapping for your module.  This is the public facing mapping
	 * that users will use to access your module features.
	 * For us it will be /~bxlens -> public mapping
	 */
	this.publicMapping = {
		name      : "~bxlens",
		usePrefix : false,
		path      : "public"
	}

	/**
	 * Who built the module
	 */
	this.author = "Luis Majano"

	/**
	 * The module description
	 */
	this.description = "A debugging and profiling lens bar for BoxLang applications."

	/**
	 * The module web URL
	 */
	this.webURL = "https://www.ortussolutions.com"

	/**
	 * This boolean flag tells the module service to skip the module registration/activation process.
	 */
	this.enabled = true

    /**
	 * The module dependencies that this module needs to be activated before this module is activated
	 */
	this.dependencies = []

	/**
	 * --------------------------------------------------------------------------
	 * Module Methods
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Called by the ModuleService on module registration.
	 * Declare settings, interceptors, and custom interception points here.
	 */
	function configure() {
		settings = {
			// Master on/off switch. Per-request override via LensEnable() / LensDisable().
			enabled : true,

			// Collector toggles — control which data is collected
			collectors : {
				queries       : true,
				http          : true,
				soap          : true,
				messages      : true,
				exceptions    : true,
				timeline      : true,
				bifCalls      : false,   // expensive - off by default
				functionCalls : false,   // expensive - off by default
				scopes : {
					enabled : true,
					form    : true,
					session : false,
					request : false
				},
				boxlangInfo : true
			},

			// Collection limits (prevent unbounded memory use on long requests)
			maxQueries        : 100,
			maxExceptions     : 50,
			maxTemplates      : 200,
			maxMessages       : 200,
			maxTimings        : 200,
			maxBifCalls       : 500,
			maxFunctionCalls  : 500,

			// UI theme sent to the client: "dark" | "light" | "auto"
			theme : "dark",

			// CSS variable overrides for custom branding (applied as inline style on #bxlens-root)
			// Example: { "--bxl-accent" : "#00ff88" }
			themeOverrides : {},

			// Editor deep-link pattern. {path} and {line} are replaced at render time.
			// Set to "" to disable clickable links.
			// Examples:
			//   vscode://file/{path}:{line}
			//   phpstorm://open?file={path}&line={line}
			editorLinkPattern : "vscode://file/{path}:{line}",

			// Internal — populated in onLoad()
			alpineSource : ""
		};

	}

	/**
	 * Called by the ModuleService on module activation.
	 */
	function onLoad() {
		// Embed Alpine.js source so LensRender() can include it inline
		var alpinePath = moduleRecord.physicalPath & "/assets/alpine.min.js";
		if ( fileExists( alpinePath ) ) {
			settings.alpineSource = fileRead( alpinePath );
		}
	}

	/**
	 * Called by the ModuleService on module deactivation.
	 */
	function onUnload() {
	}

}
