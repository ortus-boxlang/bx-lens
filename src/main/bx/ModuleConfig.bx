/**
 * bx-lens Module Configuration
 *
 * BoxLang Debug Bar — request profiling panel for web pages.
 * Drop LensRender() just before </body> on any page to inject the debug bar.
 */
class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	this.version     = "@build.version@+@build.number@";
	this.mapping     = "bxLens";
	this.author      = "Ortus Solutions";
	this.description = "BoxLang Debug Bar — request profiling panel for web pages";
	this.webURL      = "https://www.ortussolutions.com";
	this.enabled     = true;
	this.dependencies = [];

	/**
	 * Called by the ModuleService on module registration.
	 * Declare settings, interceptors, and custom interception points here.
	 */
	function configure() {
		settings = {
			// Master on/off switch. Per-request override via LensEnable() / LensDisable().
			enabled : true,

			// Collector toggles — control which data is collected
			collectors : {
				queries       : true,
				http          : true,
				soap          : true,
				messages      : true,
				exceptions    : true,
				timeline      : true,
				bifCalls      : false,   // expensive - off by default
				functionCalls : false,   // expensive - off by default
				scopes : {
					enabled : true,
					form    : true,
					session : false,
					request : false
				},
				boxlangInfo : true
			},

			// Collection limits (prevent unbounded memory use on long requests)
			maxQueries        : 100,
			maxExceptions     : 50,
			maxTemplates      : 200,
			maxMessages       : 200,
			maxTimings        : 200,
			maxBifCalls       : 500,
			maxFunctionCalls  : 500,

			// UI theme sent to the client: "dark" | "light" | "auto"
			theme : "dark",

			// CSS variable overrides for custom branding (applied as inline style on #bxlens-root)
			// Example: { "--bxl-accent" : "#00ff88" }
			themeOverrides : {},

			// Editor deep-link pattern. {path} and {line} are replaced at render time.
			// Set to "" to disable clickable links.
			// Examples:
			//   vscode://file/{path}:{line}
			//   phpstorm://open?file={path}&line={line}
			editorLinkPattern : "vscode://file/{path}:{line}",

			// Internal — populated in onLoad()
			alpineSource : ""
		};

		interceptors = [];

		customInterceptionPoints = [];
	}

	/**
	 * Called by the ModuleService on module activation.
	 */
	function onLoad() {
		// Get the LensService KEY from the class
		var svcKeyName = createObject( "java", "ortus.boxlang.modules.bxlens.LensService" ).NAME;

		// Check if already registered globally (e.g., from a prior activation)
		var svc = boxRuntime.getGlobalService( svcKeyName );
		if ( isNull( svc ) || !isObject( svc ) ) {
			svc = new ortus.boxlang.modules.bxlens.LensService( boxRuntime );
			svc.onStartup();
			boxRuntime.putGlobalService( svcKeyName, svc );
		}

		// Wire up collectors based on settings
		svc.activateCollectors( settings );

		// Embed Alpine.js source so LensRender() can include it inline
		var alpinePath = moduleRecord.physicalPath & "/assets/alpine.min.js";
		if ( fileExists( alpinePath ) ) {
			settings.alpineSource = fileRead( alpinePath );
		}
	}

	/**
	 * Called by the ModuleService on module deactivation.
	 */
	function onUnload() {
		var svcKeyName = createObject( "java", "ortus.boxlang.modules.bxlens.LensService" ).NAME;
		var svc = boxRuntime.getGlobalService( svcKeyName );
		if ( !isNull( svc ) && isObject( svc ) ) {
			svc.deactivateCollectors();
			// Don't shutdown the service itself — it's global and may serve other invocations
		}
	}

}
