/**
 * BX Lens: a request level debug bar for BoxLang web applications.
 *
 * Everything that collects data is Java (see src/main/java). This file only declares settings and wires the module lifecycle.
 * Settings go in boxlang.json under modules.bxLens.settings. Lens is OFF by default.
 */
import java:ortus.boxlang.modules.bxlens.LensService;

class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	this.version      = "@build.version@+@build.number@";
	this.mapping      = "bxlens";
	// The console lives at /~bxlens/index.bxm (a bare /~bxlens/ is not served by every web server)
	this.publicMapping = { name : "~bxlens", usePrefix : false, path : "public" };
	this.author       = "Ortus Solutions";
	this.description  = "A request level debug bar for BoxLang web applications: timeline, queries, templates, cache, modules and more.";
	this.webURL       = "https://boxlang.io";
	this.enabled      = true;
	this.dependencies = [];

	/**
	 * Settings and interception points. All settings are documented in docs/configuration.md.
	 */
	function configure() {
		settings = {
			// The bar: a strip injected into HTML pages for developers. Off by default.
			bar : {
				enabled      : false,
				// "local" (loopback only), "all", or a list of IPs, CIDRs and the words local and private
				access       : "local",
				// A second key for "all": any IP could then see request internals. Never on for a public site without a reason
				allowAllIPs  : false
			},

			// The standalone console at /~bxlens/index.bxm. Off by default and needs a password. Use a bxsecret: value in boxlang.json
			console : {
				enabled          : false,
				password         : "",
				// Optional second password: this role can look but not change anything or download dumps. Use a bxsecret: value
				viewerPassword   : "",
				// Allow heap dumps from the System page (admin only, with a confirmation). A dump holds everything in memory, including secrets
				allowHeapDump    : false,
				// Refuse the console over plain HTTP (loopback is exempt). Turn on in production
				requireHttps     : false,
				access           : "local",
				sessionMinutes   : 30,
				maxLoginAttempts : 5,
				lockoutMinutes   : 5,
				// Pause, resume, run and reload scheduled tasks from the console
				actions          : true,
				// View only: no change can be made from the console (settings, tasks, bar layout). Set it in boxlang.json only
				readOnly         : false,
				// Where console changes to the settings are saved. Empty means config/bxlens-settings.json in the BoxLang home
				overridesFile    : "",
				runTimeoutSeconds : 60,
				maxStreams       : 10
			},

			// off | light | full. Light is the default and is for production: no bindings, scopes, headers, stack traces or caller lookups,
			// and no function, log or bif collectors. Use full while you develop
			collect : { level : "light" },

			// Tabs to hide in the bar and the console. A disabled collector hides its tab too
			tabs : { hide : [] },

			// Plus: errors, reports and trends saved to disk so they survive restarts. Without Plus they stay in memory
			store : {
				enabled        : true,
				// Empty means lens-data in the BoxLang home
				dir            : "",
				retentionHours : 72,
				maxMB          : 50,
				flushSeconds   : 30
			},

			// Optional help from a language model through the bx-ai module (it ships inside Lens). Off by default: when on, redacted prompts and
			// tool results leave this server for the provider. The default is a model on this machine (Ollama), which keeps everything inside your
			// network: ollama pull llama3.2 and ollama pull nomic-embed-text. Lensy, Explain with AI and Ask Lens are BoxLang+ features.
			// apiKey takes a bxsecret: value. apiKeyEnv names an environment variable that holds the key. A key is never typed into the console
			ai : {
				enabled           : false,
				// ollama (default), openai, claude, gemini, mistral, groq, grok, deepseek, openrouter, openai-compatible, cohere or docker
				provider          : "ollama",
				model             : "llama3.2",
				baseUrl           : "http://localhost:11434",
				embeddingModel    : "nomic-embed-text",
				temperature       : "0.2",
				// Seconds an answer may take. The time a person takes to approve an action does not count
				timeoutSeconds    : 120,
				// Tool calls allowed in one answer
				maxToolCalls      : 8,
				// Messages the conversation of one console session remembers. The memory is in the JVM and gone at logout or timeout
				memoryMessages    : 20,
				// Chats that may run at once on this server
				maxConcurrentChats : 3,
				// Let the agent propose actions (run GC, tasks, caches, integrations, settings). Each one needs an Approve click
				actions           : true,
				// Let the agent search the Lens documentation (embeddings when the model is there, keywords if not)
				rag               : true,
				apiKey            : "",
				apiKeyEnv         : "",
				// Show "copy prompt" and the open-in-chat links on errors, deadlocks and queries. These send nothing from the server
				links             : true
			},

			// Which server this is. Every request, error, report, statistic and audit line carries it, so the data of many servers can be told
			// apart. Empty means detect: the host name and the primary address of the machine. Set them behind containers or NAT. When empty,
			// the environment variables LENS_SERVER_NAME and LENS_SERVER_ADDRESS are read
			server : {
				name    : "",
				address : "",
				// An id of this instance. Empty means a short id made from the host name and the start time of the JVM
				id      : ""
			},

			// Optional checks
			checks : {
				// Notes for missing security headers and cookie flags
				securityHeaders : true,
				// Sample the thread of a request that passes thresholds.slowRequestMs
				slowSample : true
			},

			// Developer options: reloadAssets serves the UI files from disk, license forces trial|plus|expired|none
			dev : { reloadAssets : false, license : "" },

			// Extra checks for both the bar and the console
			access : {
				// Restrict to these Host header names. Empty means any host
				allowedHosts : [],
				// Require a request header: "Name" or "Name=value". Empty means none
				requireHeader : "",
				// Behind a proxy or load balancer: use the client address from proxyHeader. Only believed when the direct connection
				// comes from one of proxyPeers (private = loopback and private networks, or a list of IPs and CIDRs)
				trustProxyHeader : true,
				proxyHeader : "X-Forwarded-For",
				proxyPeers : "private"
			},

			// Inject the bar before </body> on HTML responses. Set false and call lensRender() to place it yourself
			inject       : true,
			contentTypes : [ "text/html" ],
			excludePaths : [ "/~bxlens/*", "/favicon.ico" ],

			// Work a request does not need to wait for (statistics, the history, the audit log) runs on one background thread with a bounded queue.
			// When the queue is full new work is dropped and counted: a request never waits. enabled false runs that work in the request
			async : { enabled : true, queueSize : 2000 },

			// A request still running after this many minutes is finished by the watchdog as unfinished (its open spans are closed with an estimate)
			request : { maxMinutes : 10 },

			// In-memory history ring buffer. The oldest request is recycled when full. Nothing is written to disk
			history : {
				// Keep JSON, SSE and other non HTML requests in the history. Empty means off in light and on in full
				trackNonHtml : "",
				header       : "X-BxLens-Id",
				// Send the id header on every tracked request, not only when the bar is shown
				headerAlways : true,
				// Also send X-BxLens-Server with the id of this server, next to the request id header. Off by default: it names a machine
				serverHeader : false,
				maxRequests  : 50
			},

			ui : {
				// auto follows the OS, or dark | light
				theme               : "auto",
				// Start with the panel open instead of the collapsed health strip
				startOpen           : false,
				// Open the panel to Issues when an exception was caught
				autoOpenOnException : true,
				defaultTab          : "timeline",
				height              : 360,
				allowDetach         : true,
				// Toggle the panel. Modifiers: Ctrl, Alt, Shift, Meta
				hotkey              : "Ctrl+`"
			},

			// What counts as slow or suspicious
			thresholds : {
				slowRequestMs  : 500,
				slowQueryMs    : 25,
				slowTemplateMs : 100,
				nPlusOneMin    : 3
			},

			// Click-to-editor links. {path} and {line} are replaced. Map container paths with remoteBase/localBase
			editor : {
				linkPattern : "vscode://file/{path}:{line}",
				remoteBase  : "",
				localBase   : ""
			},

			// Values under these keys are masked on the server before they reach the page
			redact : {
				keys : [ "password", "pwd", "passwd", "token", "secret", "apikey", "api_key", "authorization", "cookie", "credential" ],
				mask : "[redacted]"
			},

			// Caps for any value sent to the page
			limits : {
				maxString : 2000,
				maxDepth  : 4,
				maxItems  : 100
			},

			collectors : {
				templates    : { enabled : true, max : 300 },
				// Hot path, off by default
				functions    : { enabled : false, max : 1000, minMs : 0 },
				// includeParams keeps the values bound to a query. Off by default: values can be personal data
				queries      : { enabled : true, max : 200, includeParams : false, captureCaller : true },
				// propagateId adds X-Request-Id to outgoing calls when core lets a listener change the call. Off by default
				http         : { enabled : true, max : 100, propagateId : false },
				exceptions   : { enabled : true, max : 50 },
				messages     : { enabled : true, max : 200 },
				timers       : { enabled : true, max : 200 },
				transactions : { enabled : true, max : 50 },
				logs         : { enabled : false, max : 200 },
				// Opt in: the scope viewer shows a copy of scope contents, so it is off until you ask for it. Skipped at collect.level light
				scopes       : { enabled : false, url : true, form : true, cookie : false, session : false, request : false, application : false, variables : false },
				// The Runtime tab of the bar: versions, system, uptime, heap, cache names and main settings, cached for a few seconds
				jvm          : { enabled : true },
				// Integration with bx-orm: its onORMQuery, onORMFlush and onORMException events, shown like normal queries. Opt in and needs bx-orm
				// installed: until both are true Lens registers no listener (see docs/reference/integrations.md)
				orm          : { enabled : false },
				// Time per built-in function, from postBIFInvocation. Every BIF call allocates an event while this is on, so it is off by default
				bifs         : { enabled : false },
				// Console pages. Turn one off and its page disappears
				executors    : { enabled : true },
				tasks        : { enabled : true },
				datasources  : { enabled : true },
				caches       : { enabled : true },
				logfiles     : { enabled : true },
				environment  : { enabled : true },
				modules      : { enabled : true },
				configuration : { enabled : true },
				inflight     : { enabled : true },
				errors       : { enabled : true },
				reports      : { enabled : true },
				ask          : { enabled : true },
				ai           : { enabled : true },
				system       : { enabled : true },
				threads      : { enabled : true }
			}
		};

		// Extension points for applications and other modules. See docs/guides/extending.md
		customInterceptionPoints = [
			"onLensRegister",
			"onLensRequestStart",
			"onLensCollect",
			"onLensRequestFinish"
		];

		// Lets /~bxlens/ open the console, see models/IndexRewrite.bx
		interceptors = [ { class : "#moduleRecord.invocationPath#.models.IndexRewrite", properties : {} } ];
	}

	/**
	 * Activate: parse the settings, register the collectors.
	 */
	function onLoad() {
		LensService.getInstance().getAgents().invocationPath( moduleRecord.invocationPath );
		LensService.getInstance().activate(
			boxRuntime,
			settings,
			moduleRecord.physicalPath.toString(),
			moduleRecord.version
		);
	}

	/**
	 * Other modules may have loaded after us, so ask for panel declarations again once all are active.
	 */
	function afterModuleActivations( data ) {
		LensService.getInstance().announceRegister();
	}

	function onUnload() {
		LensService.getInstance().shutdown();
	}

}
