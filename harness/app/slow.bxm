<bx:script>
	request.pageTitle = "Slow query";
	// A nested loop join over about 600 thousand combinations: well past the 15 ms threshold on any machine
	result = queryExecute( "SELECT COUNT(*) AS total FROM numbers a, numbers b, numbers c WHERE a.n <= 60 AND b.n <= 60 AND a.n * b.n + c.n > 1000 AND MOD( a.n + b.n + c.n, 3 ) = 0" );
</bx:script>
<bx:include template="/includes/header.bxm" />
<bx:output>
<h1>Slow query</h1>
<p>Counted #result.total# combinations with a triple cross join.</p>
</bx:output>
<bx:include template="/includes/footer.bxm" />
