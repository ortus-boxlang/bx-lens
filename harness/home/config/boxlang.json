{
	"modules": {
		"bxLens": {
			"settings": {
				"bar": {
					"enabled": true,
					"access": "local"
				},
				"console": {
					"enabled": true,
					"password": "lens-demo",
					"viewerPassword": "lens-view",
					"allowHeapDump": true,
					"access": "local"
				},
				"collect": {
					"level": "full"
				},
				"ui": {
					"startOpen": false,
					"autoOpenOnException": true
				},
				"thresholds": {
					"slowQueryMs": 15,
					"slowRequestMs": 3000
				},
				"collectors": {
					"functions": {
						"enabled": true,
						"max": 500
					},
					"logs": {
						"enabled": true
					},
					"scopes": {
						"enabled": true,
						"url": true,
						"form": true,
						"session": true,
						"request": true
					}
				},
				"dev": {
					"reloadAssets": true,
					"license": "@LENS_LICENSE@"
				}
			}
		}
	},
	"executors": {
		"demo-pool": {
			"type": "fixed",
			"threads": 2,
			"description": "Small pool for the harness"
		}
	},
	"mappings": {
		"/harness": "@HARNESS_APP@"
	}
}
